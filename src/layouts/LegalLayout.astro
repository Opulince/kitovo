---
/**
 * Layout for legal pages: a readable measure, a table of contents, the date
 * the text last changed, and links to the other legal pages.
 */
import BaseLayout from './BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import { formatDate, cleanPath, toHref } from '@/config/site';
import type { LegalHeading } from '@/lib/legal';
import type { Crumb } from '@/lib/seo';
import { breadcrumbJsonLd } from '@/lib/seo';

interface Props {
  title: string;
  /** Overrides the <title> (defaults to `title`). */
  metaTitle?: string;
  description: string;
  updated: string;
  eyebrow?: string;
  lead?: string;
  headings?: LegalHeading[];
  crumbs?: Crumb[];
}

const {
  title,
  metaTitle,
  description,
  updated,
  eyebrow = 'Legal',
  lead,
  headings = [],
  crumbs,
} = Astro.props;

const path = cleanPath(Astro.url);
const related = [
  { href: '/privacy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms of Use' },
  { href: '/disclaimer', label: 'Disclaimer' },
].filter((r) => r.href !== path);
---

<BaseLayout
  title={metaTitle ?? title}
  description={description}
  ogType="article"
  jsonLd={crumbs ? [breadcrumbJsonLd(crumbs)] : []}
>
  <PageHeader title={title} eyebrow={crumbs ? undefined : eyebrow} crumbs={crumbs} lead={lead} size="lg">
    <p class="legal-updated">
      <Icon name="calendar" size={16} strokeWidth={2} />
      Last updated <time datetime={updated}>{formatDate(updated)}</time>
    </p>
  </PageHeader>

  <div class="panel legal-panel">
    <div class="container legal-grid">
      {
        headings.length > 2 && (
          <aside class="legal-toc" aria-label="On this page">
            <details class="toc-box toc-mobile">
              <summary>
                On this page
                <Icon name="chevron-down" size={18} class="toc-chevron" />
              </summary>
              <ol role="list" class="toc-list">
                {headings.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} set:html={h.text} />
                  </li>
                ))}
              </ol>
            </details>
            <nav class="toc-box toc-desktop" aria-label="On this page">
              <p class="toc-title">On this page</p>
              <ol role="list" class="toc-list">
                {headings.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} set:html={h.text} />
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }

      <article class="prose">
        <slot name="before" />
        <slot />
        <slot name="after" />
      </article>
    </div>
  </div>

  <nav class="panel panel-tight legal-related" aria-label="Other legal pages">
    <div class="container related-inner">
      <p class="eyebrow">Related</p>
      <ul role="list">
        {
          related.map((r) => (
            <li>
              <a class="btn btn-secondary btn-sm" href={toHref(r.href)}>
                {r.label}
                <Icon name="arrow-right" />
              </a>
            </li>
          ))
        }
        <li>
          <a class="btn btn-secondary btn-sm" href={toHref('/contact')}>
            Contact
            <Icon name="arrow-right" />
          </a>
        </li>
      </ul>
    </div>
  </nav>
</BaseLayout>

<style>
  .legal-updated {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 0 14px;
    border-radius: var(--r-pill);
    background: var(--white);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .legal-panel {
    padding-block: clamp(32px, 5vw, 72px);
  }

  .legal-grid {
    display: grid;
    gap: 28px;
  }

  .legal-toc {
    align-self: start;
  }

  .toc-box {
    border-radius: var(--r-lg);
    background: var(--snow);
  }

  .toc-mobile summary,
  .toc-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 54px;
    padding: 0 20px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .toc-mobile summary {
    cursor: pointer;
    list-style: none;
  }

  .toc-mobile summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile :global(.toc-chevron) {
    transition: transform 0.3s var(--ease-spring);
  }

  .toc-mobile[open] :global(.toc-chevron) {
    transform: rotate(180deg);
  }

  .toc-desktop {
    display: none;
  }

  .toc-list {
    margin: 0;
    padding: 0 10px 12px;
    counter-reset: toc;
  }

  .toc-list li {
    counter-increment: toc;
  }

  .toc-list a {
    display: flex;
    gap: 10px;
    padding: 8px 10px;
    border-radius: var(--r-sm);
    color: var(--ink);
    font-size: 0.9375rem;
    line-height: 1.35;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .toc-list a::before {
    content: counter(toc, decimal-leading-zero);
    min-width: 1.8em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .toc-list a:hover {
    background: var(--white);
  }

  .related-inner {
    display: grid;
    gap: 14px;
  }

  .legal-related ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
  }

  @media (min-width: 1000px) {
    .legal-grid {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 72px;
    }

    .legal-toc {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }

    .toc-mobile {
      display: none;
    }

    .toc-desktop {
      display: block;
    }
  }
</style>

<style is:global>
  /* ---- prose (legal text, rendered from Markdown) ---- */
  .prose {
    max-width: 70ch;
    min-width: 0;
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .prose > * + * {
    margin-top: 1.1em;
  }

  .prose h2 {
    margin-top: 2.2em;
    font-size: var(--step-2);
    letter-spacing: -0.035em;
    line-height: 1.1;
    scroll-margin-top: calc(var(--header-h) + 40px);
  }

  .prose > h2:first-child {
    margin-top: 0;
  }

  .prose h3 {
    margin-top: 1.8em;
    font-size: 1.25rem;
  }

  .prose h2 + *,
  .prose h3 + * {
    margin-top: 0.7em;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.3em;
  }

  .prose li + li {
    margin-top: 0.45em;
  }

  .prose li::marker {
    color: var(--blue);
  }

  .prose a {
    font-weight: 600;
    color: var(--blue);
    overflow-wrap: anywhere;
  }

  .prose p,
  .prose li {
    color: #2a2d34;
  }

  .prose strong {
    color: var(--ink);
  }

  .prose .pending {
    padding: 14px 18px;
    border-radius: var(--r-md);
    border: 2px dashed #f2a07f;
    background: var(--tangerine-soft);
    font-size: 0.975rem;
    line-height: 1.6;
  }

  .prose .pending p,
  .prose .pending strong {
    color: #5a1f08;
  }

  .prose .summary-box {
    padding: 22px 26px;
    border-radius: var(--r-lg);
    background: var(--lilac);
  }

  .prose .summary-box > * + * {
    margin-top: 0.6em;
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin-block: 2.4em;
  }
</style>
