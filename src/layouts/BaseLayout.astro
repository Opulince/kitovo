---
/**
 * The page shell: <head> metadata (title, description, canonical, Open Graph,
 * Twitter, icons, structured data), fonts, header, main and footer.
 */
import displayFont from '@fontsource-variable/funnel-display/files/funnel-display-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/funnel-sans/files/funnel-sans-latin-wght-normal.woff2?url';
import monoFont from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff2?url';
import { site, asset, assetUrl, pageUrl, cleanPath } from '@/config/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  /** Page title. The site name is appended unless `exactTitle` is set. */
  title: string;
  description: string;
  /** Use `title` as-is (homepage). */
  exactTitle?: boolean;
  /** Absolute or root-relative OG image. Defaults to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** schema.org objects, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  exactTitle = false,
  ogImage = '/og.png',
  ogImageAlt = 'Kitovo: useful apps for everyday problems.',
  ogType = 'website',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = exactTitle ? title : `${title} · ${site.name}`;
const pathname = cleanPath(Astro.url);
const canonical = pageUrl(pathname);
const ogImageUrl = assetUrl(ogImage);

const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2190-2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Funnel Display Variable';font-style:normal;font-display:swap;font-weight:300 800;src:url(${displayFont}) format('woff2-variations'),url(${displayFont}) format('woff2');unicode-range:${latin};}
@font-face{font-family:'Funnel Sans Variable';font-style:normal;font-display:swap;font-weight:300 800;src:url(${bodyFont}) format('woff2-variations'),url(${bodyFont}) format('woff2');unicode-range:${latin};}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:500;src:url(${monoFont}) format('woff2');unicode-range:${latin};}
`;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />

    <link rel="icon" href={asset('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/site.webmanifest')} />
    <meta name="theme-color" content="#eceef3" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="sitemap" href={asset('/sitemap.xml')} />
    <meta name="generator" content={Astro.generator} />

    {
      jsonLd.map((data) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
