---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AppCard from '@/components/AppCard.astro';
import Icon from '@/components/Icon.astro';
import { toHref } from '@/config/site';
import { apps, supportPath } from '@/data/apps';

const other = [
  {
    icon: 'chat' as const,
    title: 'Contact Kitovo',
    body: 'General questions, business inquiries, or anything not about a specific app.',
    href: '/contact',
  },
  {
    icon: 'lock' as const,
    title: 'Privacy questions',
    body: 'How the website and each app handle your information, and how to make a request.',
    href: '/privacy',
  },
  {
    icon: 'doc' as const,
    title: 'Terms and disclaimer',
    body: 'The rules for using Kitovo apps, and what they can and can’t guarantee.',
    href: '/terms',
  },
];
---

<BaseLayout
  title="Support"
  description="Get help with Kitovo apps: troubleshooting steps, account help, bug reporting and how to contact support for each app."
>
  <PageHeader
    eyebrow="Support"
    title="How can we help?"
    lead="Pick an app for troubleshooting steps, answers to common questions and the right way to reach us."
  />

  <section class="panel panel-snow support-panel" aria-labelledby="choose-title">
    <div class="container">
      <h2 id="choose-title" class="support-sub">Choose an app</h2>
      <ul role="list" class="support-apps">
        {
          apps.map((app) => (
            <li>
              <AppCard app={app} href={supportPath(app)} cta="Get help" />
            </li>
          ))
        }
      </ul>

      <h2 class="support-sub support-sub-2" id="other-title">Something else?</h2>
      <ul role="list" class="other-help" aria-labelledby="other-title">
        {
          other.map((item) => (
            <li class="other-card card card-interactive">
              <span class="other-icon" aria-hidden="true">
                <Icon name={item.icon} size={22} strokeWidth={2} />
              </span>
              <h3>
                <a href={toHref(item.href)} class="stretched-link">
                  {item.title}
                </a>
              </h3>
              <p>{item.body}</p>
              <span class="other-go" aria-hidden="true">
                <Icon name="arrow-right" size={20} strokeWidth={2} />
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .support-panel {
    padding-block: clamp(24px, 4vw, 48px);
  }

  .support-sub {
    font-size: var(--step-2);
    margin-bottom: 16px;
  }

  .support-sub-2 {
    margin-top: clamp(40px, 6vw, 64px);
  }

  .support-apps,
  .other-help {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  @media (min-width: 720px) {
    .support-apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .support-apps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 860px) {
    .other-help {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .other-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px;
  }

  .other-icon {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border-radius: 50%;
    background: var(--lilac);
    margin-bottom: 14px;
  }

  .other-card h3 {
    font-size: 1.5rem;
  }

  .other-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .other-card p {
    color: var(--muted);
  }

  .other-go {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    margin-top: auto;
    border-radius: 50%;
    background: var(--snow);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.35s var(--ease-spring);
  }

  .other-card:hover .other-go {
    background: var(--ink);
    color: #fff;
    transform: translateX(4px);
  }

  .other-card:focus-within {
    outline: 3px solid var(--blue);
    outline-offset: 3px;
  }

  .other-card:focus-within :focus-visible {
    outline: none;
  }
</style>
