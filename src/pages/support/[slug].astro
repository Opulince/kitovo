---
/**
 * Support for one app, generated from the app's `support` data.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AppIcon from '@/components/AppIcon.astro';
import FAQ from '@/components/FAQ.astro';
import Icon from '@/components/Icon.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { apps, appPath, privacyPath, supportPath, androidPlatform } from '@/data/apps';
import type { AppDefinition } from '@/data/apps';
import { mailto, toHref } from '@/config/site';
import { breadcrumbJsonLd, faqJsonLd } from '@/lib/seo';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

interface Props {
  app: AppDefinition;
}

const { app } = Astro.props;
const crumbs = [
  { href: '/support', label: 'Support' },
  { href: supportPath(app), label: app.name },
];
const android = androidPlatform(app);
const notReleased = !app.platforms.some((p) => p.status === 'available');

const sections = [
  { id: 'troubleshooting', label: 'Troubleshooting' },
  { id: 'account', label: 'Account & data' },
  { id: 'report-a-bug', label: 'Report a bug' },
  { id: 'faq', label: 'FAQ' },
];

const supportMail = mailto(app.supportEmail, `${app.name} support`);
const bugMail = mailto(app.supportEmail, `Bug report: ${app.name}`);
---

<BaseLayout
  title={`${app.name} support`}
  description={`Help with ${app.name}: troubleshooting, account and data questions, bug reporting and how to contact ${app.name} support.`}
  jsonLd={[breadcrumbJsonLd(crumbs), faqJsonLd(app.faq)]}
>
  <PageHeader
    title={`${app.name} support`}
    lead={`Help with ${app.name}, the ${app.descriptor} by Kitovo.`}
    crumbs={crumbs}
  >
    <AppIcon app={app} size={72} slot="before-title" class="head-icon" />
    {
      notReleased && android && (
        <div class="release-note" role="note">
          <Icon name="clock" size={20} strokeWidth={2} />
          <p>
            <strong>{app.name} isn’t on Google Play yet.</strong> The Android app is{' '}
            {android.note ? android.note.toLowerCase() : 'coming soon'}. This page covers the app as
            it ships. Questions in the meantime? Email{' '}
            <a href={supportMail}>{app.supportEmail}</a>.
          </p>
        </div>
      )
    }
  </PageHeader>

  <div class="panel support-panel">
    <div class="container support-layout">
      <aside class="support-aside" aria-label={`Contact ${app.name} support`}>
        <div class="contact-card on-dark">
          <h2 class="contact-title">Contact support</h2>
          <p>Email is the fastest way to reach us about {app.name}.</p>
          <a class="contact-email" href={supportMail}>{app.supportEmail}</a>
          <div class="contact-actions">
            <a class="btn btn-light" href={supportMail}>
              <Icon name="mail" />
              Email support
            </a>
            <a class="btn btn-outline-light" href={bugMail}>
              <Icon name="bug" />
              Report a bug
            </a>
          </div>
          <ul role="list" class="contact-links">
            <li><a href={toHref(appPath(app))}>About {app.name}</a></li>
            <li><a href={toHref(privacyPath(app))}>{app.name} privacy policy</a></li>
            <li><a href={toHref('/disclaimer')}>Disclaimer</a></li>
          </ul>
          <div class="contact-status">
            {app.platforms.map((p) => <StatusBadge status={p.status} platform={p.name} size="sm" tone="dark" />)}
          </div>
        </div>
      </aside>

      <div class="support-main">
        <nav class="jump" aria-label="On this page">
          <ul role="list">
            {sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}
          </ul>
        </nav>

        <section id="troubleshooting" class="support-section" aria-labelledby="troubleshooting-title">
          <h2 id="troubleshooting-title">Troubleshooting</h2>
          <div class="trouble-list">
            {
              app.support.troubleshooting.map((item) => (
                <article class="trouble">
                  <h3>{item.title}</h3>
                  <ol>
                    {item.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                </article>
              ))
            }
          </div>
        </section>

        <section id="account" class="support-section" aria-labelledby="account-title">
          <h2 id="account-title">Account &amp; data</h2>
          <dl class="topics">
            {
              app.support.account.map((topic) => (
                <div class="topic">
                  <dt>{topic.title}</dt>
                  <dd>{topic.body}</dd>
                </div>
              ))
            }
          </dl>
          <a class="link-arrow support-more" href={toHref(privacyPath(app))}>
            Read the full {app.name} privacy policy
            <Icon name="arrow-right" />
          </a>
        </section>

        <section id="report-a-bug" class="support-section bug-box on-tangerine" aria-labelledby="bug-title">
          <h2 id="bug-title">Report a bug</h2>
          <p>
            Found something that isn’t working? Email <a href={bugMail}>{app.supportEmail}</a> with
            “Bug report” in the subject. These details help us fix it faster:
          </p>
          <ul class="bug-list">
            {app.support.bugReport.include.map((item) => <li>{item}</li>)}
          </ul>
          {app.support.bugReport.note && <p class="bug-note">{app.support.bugReport.note}</p>}
          <a class="btn btn-primary bug-btn" href={bugMail}>
            <Icon name="bug" />
            Email a bug report
          </a>
        </section>

        <section id="faq" class="support-section" aria-labelledby="faq-title">
          <h2 id="faq-title">Frequently asked questions</h2>
          <FAQ items={app.faq} />
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(.head-icon) {
    margin-top: 10px;
  }

  .release-note {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 8px;
    max-width: 760px;
    padding: 16px 20px;
    border-radius: var(--r-md);
    background: var(--white);
  }

  .release-note :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--tangerine);
  }

  .support-panel {
    padding-block: clamp(28px, 4vw, 56px) var(--panel-y);
  }

  .support-layout {
    display: grid;
    gap: 40px;
  }

  .contact-card {
    display: grid;
    gap: 12px;
    padding: 28px;
    border-radius: var(--r-panel);
    background: var(--ink);
    color: #fff;
  }

  .contact-title {
    font-size: var(--step-2);
  }

  .contact-card > p {
    color: #c4c7d0;
  }

  .contact-email {
    font-weight: 650;
    color: var(--tangerine);
    word-break: break-all;
  }

  .contact-actions {
    display: grid;
    gap: 10px;
    margin-top: 8px;
  }

  .contact-links {
    display: grid;
    margin: 8px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: #fff;
  }

  .contact-status {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--r-pill);
    background: var(--snow);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .jump a:hover {
    background: var(--ink);
    color: #fff;
  }

  .support-section {
    padding-top: clamp(44px, 6vw, 64px);
  }

  .support-section > h2 {
    font-size: var(--step-3);
    margin-bottom: 22px;
  }

  .support-section > p {
    color: var(--muted);
    max-width: 65ch;
  }

  .trouble-list {
    display: grid;
    gap: 10px;
  }

  .trouble {
    padding: 24px 26px;
    border-radius: var(--r-lg);
    background: var(--snow);
  }

  .trouble h3 {
    font-size: 1.375rem;
  }

  .trouble ol {
    display: grid;
    gap: 8px;
    margin-top: 14px;
    padding-left: 1.4em;
    color: var(--muted);
  }

  .trouble li::marker {
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .topics {
    display: grid;
    gap: 10px;
  }

  .topic {
    display: grid;
    gap: 4px;
    padding: 20px 24px;
    border-radius: var(--r-lg);
    background: var(--lilac);
  }

  .topic dt {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .topic dd {
    margin: 0;
  }

  .support-more {
    margin-top: 14px;
  }

  .bug-box {
    margin-top: clamp(44px, 6vw, 64px);
    padding: clamp(26px, 4vw, 40px);
    border-radius: var(--r-panel);
    background: var(--tangerine);
  }

  .bug-box > p {
    color: var(--ink);
  }

  .bug-list {
    display: grid;
    gap: 8px;
    margin: 16px 0 0;
    padding-left: 1.2em;
  }

  .bug-note {
    margin-top: 18px;
    padding: 14px 18px;
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.45);
    font-weight: 600;
  }

  .bug-btn {
    margin-top: 22px;
  }

  @media (min-width: 960px) {
    .support-layout {
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 56px;
      align-items: start;
    }

    .support-aside {
      order: 2;
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }

    .support-main {
      order: 1;
    }
  }
</style>
