---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { toHref } from '@/config/site';

const links = [
  { href: '/apps', label: 'Browse apps' },
  { href: '/support', label: 'Get support' },
  { href: '/contact', label: 'Contact Kitovo' },
];
---

<BaseLayout
  title="Page not found"
  description="This page doesn't exist. Head back to Kitovo's apps, support or contact pages."
  noindex
>
  <section class="panel panel-blue on-blue nf">
    <div class="container nf-inner">
      <div class="nf-dock" aria-hidden="true">
        <span></span><span></span><span class="nf-missing"></span><span></span>
      </div>
      <p class="eyebrow">Error 404</p>
      <h1>This page isn’t on the home screen.</h1>
      <p class="lead">
        The link may be out of date, or the address may have a typo. These should get you back on
        track.
      </p>
      <div class="btn-row">
        <a class="btn btn-light" href={toHref('/')}>
          Go to the homepage
          <Icon name="arrow-right" />
        </a>
        {links.map((l) => <a class="btn btn-ghost" href={toHref(l.href)}>{l.label}</a>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: min(78svh, 760px);
    display: grid;
    align-items: center;
  }

  .nf-inner {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .nf h1 {
    font-size: var(--step-5);
    line-height: 0.92;
    letter-spacing: -0.055em;
    max-width: 13ch;
  }

  .nf-dock {
    display: flex;
    gap: 12px;
    padding: 12px;
    margin-bottom: 12px;
    border-radius: 28px;
    background: rgb(255 255 255 / 0.14);
  }

  .nf-dock span {
    inline-size: 52px;
    block-size: 52px;
    border-radius: var(--r-icon);
    background: rgb(255 255 255 / 0.9);
  }

  .nf-dock .nf-missing {
    background: transparent;
    border: 2px dashed rgb(255 255 255 / 0.6);
    animation: wobble 2.4s ease-in-out infinite;
  }

  @keyframes wobble {
    0%,
    100% {
      transform: rotate(0);
    }
    50% {
      transform: rotate(8deg);
    }
  }
</style>
