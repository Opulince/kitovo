---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AppIcon from '@/components/AppIcon.astro';
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/components/icons';
import { site, mailto, toHref } from '@/config/site';
import { apps, supportPath } from '@/data/apps';

interface Topic {
  id: string;
  icon: IconName;
  title: string;
  body: string;
  email: string;
  subject: string;
  action: string;
  tone: 'tangerine' | 'lilac' | 'white';
}

const firstApp = apps[0]!;

const topics: Topic[] = [
  {
    id: 'bug',
    icon: 'bug',
    title: 'Bug report',
    body: 'Something in an app isn’t working as it should. Tell us what happened and on which phone.',
    email: firstApp.supportEmail,
    subject: `Bug report: ${firstApp.name}`,
    action: 'Report a bug',
    tone: 'tangerine',
  },
  {
    id: 'general',
    icon: 'chat',
    title: 'General inquiry',
    body: 'Questions about Kitovo, feedback, or an idea for an app that should exist.',
    email: site.contact.generalEmail,
    subject: 'General inquiry',
    action: 'Send a message',
    tone: 'lilac',
  },
  {
    id: 'business',
    icon: 'briefcase',
    title: 'Business inquiry',
    body: 'Partnerships, press, or anything else business-related.',
    email: site.contact.businessEmail,
    subject: 'Business inquiry',
    action: 'Get in touch',
    tone: 'white',
  },
];

const allAddresses = new Set([...apps.map((a) => a.supportEmail), ...topics.map((t) => t.email)]);
const sharedInbox = allAddresses.size === 1 ? [...allAddresses][0] : null;
---

<BaseLayout
  title="Contact"
  description="How to contact Kitovo: app support, bug reports, general and business inquiries. Email is the fastest way to reach us."
>
  <PageHeader
    eyebrow="Contact"
    title="Get in touch."
    lead="Email is the best way to reach Kitovo. Pick a topic and your email app opens with the subject line filled in."
    tone="tangerine"
  >
    {
      sharedInbox && (
        <a class="inbox" href={mailto(sharedInbox)}>
          <Icon name="mail" size={22} strokeWidth={2} />
          {sharedInbox}
        </a>
      )
    }
  </PageHeader>

  <section class="panel panel-snow contact-panel" aria-label="Ways to reach us">
    <div class="container contact-grid">
      <article class="topic topic-support" aria-labelledby="support-title">
        <span class="topic-icon" aria-hidden="true"><Icon name="help" size={24} strokeWidth={2} /></span>
        <h2 id="support-title">App support</h2>
        <p>
          Questions about using an app? Each app has a support page with troubleshooting steps and
          answers to common questions.
        </p>
        <ul role="list" class="app-contacts">
          {
            apps.map((app) => (
              <li>
                <AppIcon app={app} size={44} />
                <span class="app-contact-text">
                  <span class="app-contact-name">{app.name}</span>
                  <a href={mailto(app.supportEmail, `${app.name} support`)}>{app.supportEmail}</a>
                </span>
                <a class="btn btn-light btn-sm" href={toHref(supportPath(app))}>
                  Support page
                  <Icon name="arrow-right" />
                </a>
              </li>
            ))
          }
        </ul>
      </article>

      {
        topics.map((topic) => (
          <article id={topic.id} class:list={['topic', `topic-${topic.tone}`]}>
            <span class="topic-icon" aria-hidden="true">
              <Icon name={topic.icon} size={24} strokeWidth={2} />
            </span>
            <h2>{topic.title}</h2>
            <p>{topic.body}</p>
            <a class="btn btn-primary topic-btn" href={mailto(topic.email, topic.subject)}>
              <Icon name="mail" />
              {topic.action}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="panel" aria-labelledby="before-title">
    <div class="container before">
      <h2 id="before-title">Before you write</h2>
      <ul role="list">
        <li>
          <span class="before-n" aria-hidden="true">
            <Icon name="phone" size={20} strokeWidth={2} />
          </span>
          Mention which app you’re writing about, and your phone model if something isn’t working.
        </li>
        <li>
          <span class="before-n" aria-hidden="true">
            <Icon name="lock" size={20} strokeWidth={2} />
          </span>
          Never send passwords, sign-in codes or card numbers. We will never ask for them.
        </li>
        <li>
          <span class="before-n" aria-hidden="true">
            <Icon name="doc" size={20} strokeWidth={2} />
          </span>
          <span>
            For questions about your data, the <a href={toHref('/privacy')}>privacy policies</a> may
            already have the answer.
          </span>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .inbox {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    min-height: 56px;
    padding: 0 24px;
    border-radius: var(--r-pill);
    background: var(--ink);
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.9rem + 1vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    word-break: break-all;
    transition: transform 0.35s var(--ease-spring);
  }

  .inbox:hover {
    transform: translateY(-2px);
  }

  .contact-panel {
    padding-block: clamp(4px, 1vw, 8px);
  }

  .contact-grid {
    display: grid;
    gap: 12px;
  }

  .topic {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(24px, 3vw, 34px);
    border-radius: var(--r-panel);
    background: var(--white);
  }

  .topic h2 {
    font-size: var(--step-2);
  }

  .topic > p {
    color: var(--muted);
    max-width: 52ch;
  }

  .topic-tangerine {
    background: var(--tangerine);
  }

  .topic-tangerine > p {
    color: var(--ink);
  }

  .topic-lilac {
    background: var(--lilac);
  }

  .topic-support {
    background: var(--blue);
    color: #fff;
  }

  .topic-support > p {
    color: var(--blue-soft);
  }

  .topic-icon {
    display: grid;
    place-items: center;
    inline-size: 52px;
    block-size: 52px;
    border-radius: 50%;
    background: rgb(16 17 20 / 0.08);
    margin-bottom: 18px;
  }

  .topic-support .topic-icon {
    background: rgb(255 255 255 / 0.16);
  }

  .topic-btn {
    margin-top: auto;
    align-self: flex-start;
  }

  .topic > p + .topic-btn {
    margin-top: 22px;
  }

  .app-contacts {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
  }

  .app-contacts li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 16px;
    padding: 14px;
    border-radius: var(--r-md);
    background: rgb(16 17 20 / 0.18);
  }

  .app-contact-text {
    display: grid;
    min-width: 0;
    flex: 1;
  }

  .app-contact-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .app-contact-text a {
    color: var(--blue-soft);
    word-break: break-all;
  }

  .before {
    display: grid;
    gap: 24px;
  }

  .before h2 {
    font-size: var(--step-3);
  }

  .before ul {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .before li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 16px 18px;
    border-radius: var(--r-md);
    background: var(--snow);
    font-size: 1.0625rem;
  }

  .before-n {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: var(--white);
  }

  @media (min-width: 760px) {
    .contact-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .topic-support {
      grid-column: 1 / -1;
    }

    .topic-support .app-contacts {
      max-width: 720px;
    }
  }

  @media (min-width: 960px) {
    .before {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: 48px;
    }
  }
</style>
