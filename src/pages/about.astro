---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import LogoMark from '@/components/LogoMark.astro';
import AppIcon from '@/components/AppIcon.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { toHref } from '@/config/site';
import { apps, appPath, statusLabel, primaryPlatform } from '@/data/apps';
import { organizationJsonLd } from '@/lib/seo';

const principles = [
  {
    title: 'Useful over bloated',
    body: 'Every feature has to earn its place. If it doesn’t help you get something done, it doesn’t go in.',
  },
  {
    title: 'Simple over complicated',
    body: 'You should understand a Kitovo app in a minute, without a tutorial or a maze of settings.',
  },
  {
    title: 'Real problems first',
    body: 'Each app starts from one specific, everyday annoyance, like a free trial that quietly turns into a charge.',
  },
];
---

<BaseLayout
  title="About"
  description="Kitovo builds small, useful Android apps for problems that are easier to solve with the right tool. Here is what that means in practice."
  jsonLd={[organizationJsonLd()]}
>
  <PageHeader
    eyebrow="About"
    title="Small apps for problems that deserve a proper tool."
    lead="Kitovo builds small, useful Android apps for problems that are easier to solve with the right tool."
    tone="blue"
  />

  <section class="panel" aria-labelledby="what-title">
    <div class="container about-grid">
      <h2 id="what-title">What Kitovo is</h2>
      <div class="about-text">
        <p>
          Kitovo is an independent app publisher. Each app it makes is meant to do one job, do it
          properly, and stay out of your way the rest of the time.
        </p>
        <p>
          Kitovo is the name on the door. The apps are what you actually use, and each one gets its
          own page, its own support and its own privacy policy here.
        </p>
      </div>
    </div>
  </section>

  <section class="panel panel-lilac" aria-labelledby="make-title">
    <div class="container about-grid">
      <h2 id="make-title">What we make</h2>
      <div class="about-text">
        <ul role="list" class="about-apps">
          {
            apps.map((app) => {
              const platform = primaryPlatform(app);
              return (
                <li>
                  <AppIcon app={app} size={64} />
                  <div>
                    <a href={toHref(appPath(app))}>{app.name}</a>
                    <span class="about-app-meta">
                      {platform.name} · {statusLabel[platform.status]}
                    </span>
                    <p>{app.summary}</p>
                  </div>
                </li>
              );
            })
          }
        </ul>
        <p>
          More apps will follow. They’ll appear on the <a href={toHref('/apps')}>apps page</a> when
          they are ready for everyday use.
        </p>
      </div>
    </div>
  </section>

  <section class="panel panel-ink on-dark" aria-labelledby="how-title">
    <div class="container about-grid">
      <h2 id="how-title">How we build</h2>
      <ul role="list" class="about-principles">
        {
          principles.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="panel" aria-labelledby="mark-title">
    <div class="container about-grid">
      <h2 id="mark-title">The mark</h2>
      <div class="about-text about-mark">
        <span class="about-mark-tile" aria-hidden="true"><LogoMark size={72} /></span>
        <p>
          Three app tiles and a dot, like the corner of a phone’s home screen. The dot sits where a
          notification badge would: a small app telling you something useful at the right moment.
          That’s the job every Kitovo app is built to do.
        </p>
      </div>
    </div>
  </section>

  <CtaBand tone="tangerine" labelledby="contact-title">
    <h2 id="contact-title">Questions, ideas, or something broken?</h2>
    <p>The contact page has the fastest way to reach us, and Support has help for each app.</p>
    <Fragment slot="actions">
      <a class="btn btn-primary" href={toHref('/contact')}>
        Contact Kitovo
        <Icon name="arrow-right" />
      </a>
      <a class="btn btn-ghost" href={toHref('/support')}>Get support</a>
    </Fragment>
  </CtaBand>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: 24px;
  }

  .about-grid > h2 {
    font-size: var(--step-3);
  }

  .about-text {
    display: grid;
    gap: 18px;
    max-width: 62ch;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .about-text > p {
    color: var(--muted);
  }

  .about-apps {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .about-apps li {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 22px;
    border-radius: var(--r-lg);
    background: var(--white);
  }

  .about-apps a {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .about-apps a:hover {
    text-decoration: underline;
  }

  .about-app-meta {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about-apps p {
    margin-top: 10px;
    font-size: 1.0625rem;
    color: var(--muted);
  }

  .about-principles {
    display: grid;
    gap: 28px;
    margin: 0;
  }

  .about-principles h3 {
    font-size: var(--step-2);
    letter-spacing: -0.035em;
  }

  .about-principles p {
    margin-top: 8px;
    color: #c4c7d0;
    font-size: 1.0625rem;
    max-width: 52ch;
  }

  .about-mark {
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 26px;
  }

  .about-mark-tile {
    display: grid;
    place-items: center;
    inline-size: 120px;
    block-size: 120px;
    border-radius: var(--r-icon);
    background: var(--snow);
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: 48px;
    }
  }

  @media (max-width: 479px) {
    .about-mark {
      grid-template-columns: 1fr;
    }
  }
</style>
