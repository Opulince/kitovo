---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeScreen from '@/components/HomeScreen.astro';
import AppCard from '@/components/AppCard.astro';
import MoreAppsCard from '@/components/MoreAppsCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import type { IconName } from '@/components/icons';
import { site, mailto, toHref } from '@/config/site';
import { apps } from '@/data/apps';
import { organizationJsonLd, websiteJsonLd } from '@/lib/seo';

interface Setting {
  icon: IconName;
  title: string;
  on: boolean;
  body: string;
  tone: 'tangerine' | 'blue' | 'lilac' | 'off';
}

/** How every Kitovo app is built, as Android quick-settings tiles. */
const settings: Setting[] = [
  {
    icon: 'check',
    title: 'Useful',
    on: true,
    tone: 'tangerine',
    body: 'Every feature has to earn its place by helping you get something done.',
  },
  {
    icon: 'minus',
    title: 'Simple',
    on: true,
    tone: 'blue',
    body: 'You should get a Kitovo app in a minute. No tutorial, no maze of settings.',
  },
  {
    icon: 'target',
    title: 'Real problems',
    on: true,
    tone: 'lilac',
    body: 'Each app starts from one everyday annoyance, like a free trial that quietly turns into a charge.',
  },
  {
    icon: 'layers',
    title: 'Bloat',
    on: false,
    tone: 'off',
    body: 'Feature lists for their own sake. Switched off, and it stays off.',
  },
];
---

<BaseLayout
  title={`${site.name}: ${site.tagline.replace(/\.$/, '')}`}
  exactTitle
  description={site.description}
  jsonLd={[organizationJsonLd(), websiteJsonLd()]}
>
  <HomeScreen />

  <!-- App drawer -->
  <section id="apps" class="panel" aria-labelledby="apps-title">
    <div class="container">
      <div class="section-header drawer-head">
        <p class="eyebrow">App drawer</p>
        <h2 id="apps-title">Small apps that each do one job well.</h2>
        <p>
          Everything Kitovo publishes lives here. Every app gets its own page, its own support and
          its own privacy policy.
        </p>
      </div>

      <div class="apps-list">
        {apps.map((app) => <AppCard app={app} variant="featured" />)}
        <MoreAppsCard />
      </div>
    </div>
  </section>

  <!-- Quick settings -->
  <section class="panel panel-ink on-dark" aria-labelledby="qs-title">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">How we build</p>
        <h2 id="qs-title">Kitovo’s quick settings.</h2>
        <p>The defaults every Kitovo app ships with.</p>
      </div>

      <ul role="list" class="qs-grid">
        {
          settings.map((s) => (
            <li class:list={['qs-tile', `qs-${s.tone}`, { 'on-tangerine': s.tone === 'tangerine' }]}>
              <div class="qs-top">
                <span class="qs-icon" aria-hidden="true">
                  <Icon name={s.icon} size={22} strokeWidth={2} />
                </span>
                <span class:list={['qs-switch', { 'is-on': s.on }]} aria-hidden="true">
                  <span class="qs-knob" />
                </span>
              </div>
              <h3 class="qs-title">
                <span class:list={{ 'qs-struck': !s.on }}>{s.title}</span>
              </h3>
              <p class="qs-state">{s.on ? 'On' : 'Off'}</p>
              <p class="qs-body">{s.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand tone="tangerine" labelledby="idea-title">
    <h2 id="idea-title">Got a problem that should have an app?</h2>
    <p>
      Kitovo’s apps start with everyday annoyances. If one keeps getting in your way, tell us
      about it.
    </p>
    <Fragment slot="actions">
      <a class="btn btn-primary" href={mailto(site.contact.generalEmail, 'App idea for Kitovo')}>
        <Icon name="mail" />
        Share an idea
      </a>
      <a class="btn btn-ghost" href={toHref('/contact')}>Other ways to reach us</a>
    </Fragment>
  </CtaBand>
</BaseLayout>

<style>
  .drawer-head {
    max-width: 820px;
  }

  .apps-list {
    display: grid;
    gap: 14px;
  }

  /* ---- quick settings ---- */
  .qs-grid {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .qs-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
    border-radius: var(--r-lg);
    color: var(--text);
    transition: transform 0.4s var(--ease-spring);
  }

  .qs-tile:hover {
    transform: translateY(-4px) rotate(-0.6deg);
  }

  .qs-tangerine {
    background: var(--tangerine);
    color: #101114;
  }

  .qs-blue {
    background: var(--blue);
    color: #fff;
  }

  .qs-lilac {
    background: var(--lilac);
  }

  .qs-off {
    background: var(--ink-2);
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.1);
  }

  .qs-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  .qs-icon {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border-radius: 50%;
    background: rgb(16 17 20 / 0.1);
  }

  .qs-blue .qs-icon,
  .qs-off .qs-icon {
    background: rgb(255 255 255 / 0.14);
  }

  .qs-switch {
    position: relative;
    inline-size: 52px;
    block-size: 30px;
    border-radius: var(--r-pill);
    background: rgb(16 17 20 / 0.85);
  }

  .qs-blue .qs-switch {
    background: rgb(255 255 255 / 0.95);
  }

  .qs-knob {
    position: absolute;
    top: 4px;
    left: 4px;
    inline-size: 22px;
    block-size: 22px;
    border-radius: 50%;
    background: #fff;
    transition: transform 0.4s var(--ease-spring);
  }

  .qs-switch.is-on .qs-knob {
    transform: translateX(22px);
  }

  .qs-blue .qs-knob {
    background: var(--blue);
  }

  .qs-off .qs-switch {
    background: rgb(255 255 255 / 0.16);
  }

  .qs-off .qs-knob {
    background: #8b8f9a;
  }

  /* try to turn bloat on: it refuses */
  .qs-off:hover .qs-knob {
    animation: nope 0.5s var(--ease-out);
  }

  .qs-title {
    font-size: var(--step-3);
    letter-spacing: -0.045em;
  }

  .qs-struck {
    text-decoration: line-through;
    text-decoration-color: var(--tangerine);
    text-decoration-thickness: 0.09em;
  }

  .qs-state {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .qs-body {
    margin-top: auto;
    padding-top: 18px;
    line-height: 1.5;
    max-width: 34ch;
  }

  .qs-off .qs-body,
  .qs-off .qs-state {
    color: #c4c7d0;
    opacity: 1;
  }

  .qs-blue .qs-body {
    color: var(--blue-soft);
  }

  @keyframes nope {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(9px);
    }
    50% {
      transform: translateX(-3px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  @media (min-width: 640px) {
    .qs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .qs-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .qs-tile {
      min-height: 340px;
    }
  }
</style>
