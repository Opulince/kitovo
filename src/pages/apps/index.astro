---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import AppCard from '@/components/AppCard.astro';
import MoreAppsCard from '@/components/MoreAppsCard.astro';
import Icon from '@/components/Icon.astro';
import { apps, appPath } from '@/data/apps';
import { pageUrl, toHref } from '@/config/site';

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Kitovo apps',
  itemListElement: apps.map((app, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: pageUrl(appPath(app)),
    name: app.name,
  })),
};
---

<BaseLayout
  title="Apps"
  description="Every Android app published by Kitovo, in one place. Each app is built to do one everyday job, with its own support and privacy policy."
  jsonLd={[itemList]}
>
  <PageHeader
    eyebrow="App drawer"
    title="Kitovo apps"
    lead="Every app Kitovo publishes, in one place. Each one is built for a single everyday job and has its own support page and privacy policy."
  />

  <section class="panel panel-snow apps-panel" aria-label="All apps">
    <div class="container">
      <ul role="list" class="apps-grid">
        {
          apps.map((app) => (
            <li>
              <AppCard app={app} headingLevel="h2" />
            </li>
          ))
        }
        <li>
          <MoreAppsCard compact />
        </li>
      </ul>

      <div class="apps-help">
        <Icon name="help" size={22} />
        <p>
          Using one of our apps and need help?{' '}
          <a href={toHref('/support')}>Go to Support</a>, or read each app’s{' '}
          <a href={toHref('/privacy')}>privacy policy</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .apps-panel {
    padding-block: 0 clamp(24px, 4vw, 48px);
  }

  .apps-grid {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .apps-grid > li {
    min-width: 0;
  }

  @media (min-width: 720px) {
    .apps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .apps-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .apps-help {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 12px;
    padding: 20px 24px;
    border-radius: var(--r-lg);
    background: var(--white);
  }

  .apps-help :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--blue);
  }
</style>
