---
/**
 * Site header: a floating pill. Desktop shows three links and one call to
 * action; mobile shows a menu button that opens a full-screen panel.
 *
 * The mobile menu uses the HTML popover attribute, so it opens, closes on
 * Escape and on outside taps, and restores focus without any JavaScript.
 */
import { primaryNav, cleanPath, toHref } from '@/config/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = cleanPath(Astro.url);
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

const mobileLinks = [{ href: '/', label: 'Home' }, ...primaryNav, { href: '/contact', label: 'Contact' }];
const legal = [
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
  { href: '/disclaimer', label: 'Disclaimer' },
];
---

<header class="site-header">
  <div class="header-pill">
    <a href={toHref('/')} class="brand" aria-label="Kitovo, home">
      <Logo />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul role="list">
        {
          primaryNav.map((item) => (
            <li>
              <a href={toHref(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a href={toHref('/apps')} class="btn btn-primary btn-sm header-cta">
        Explore apps
        <Icon name="arrow-right" />
      </a>
      <button
        type="button"
        class="menu-button"
        popovertarget="mobile-menu"
        popovertargetaction="show"
        aria-controls="mobile-menu"
        aria-haspopup="dialog"
      >
        <Icon name="menu" size={22} strokeWidth={2} />
        <span class="visually-hidden">Open menu</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu on-blue" popover role="dialog" aria-label="Menu">
    <div class="mobile-menu-inner">
      <div class="mobile-menu-top">
        <a href={toHref('/')} class="brand" aria-label="Kitovo, home"><Logo tone="light" /></a>
        <button
          type="button"
          class="menu-button menu-close"
          popovertarget="mobile-menu"
          popovertargetaction="hide"
          aria-controls="mobile-menu"
        >
          <Icon name="close" size={22} strokeWidth={2} />
          <span class="visually-hidden">Close menu</span>
        </button>
      </div>

      <nav aria-label="Main">
        <ul role="list" class="mobile-links">
          {
            mobileLinks.map((item, i) => (
              <li style={`--i:${i}`}>
                <a href={toHref(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                  <Icon name="arrow-right" size={26} strokeWidth={2} />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a href={toHref('/apps')} class="btn btn-light mobile-cta">
        Explore apps
        <Icon name="arrow-right" />
      </a>

      <ul role="list" class="mobile-legal">
        {legal.map((item) => <li><a href={toHref(item.href)}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: var(--edge);
    z-index: 50;
    margin: var(--edge) var(--edge) 0;
  }

  .header-pill {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: var(--header-h);
    padding: 8px 8px 8px 20px;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.86);
    backdrop-filter: saturate(1.6) blur(16px);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    box-shadow:
      0 0 0 1px rgb(16 17 20 / 0.05),
      0 10px 30px -18px rgb(16 17 20 / 0.35);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-radius: var(--r-pill);
    text-decoration: none;
    color: inherit;
  }

  .nav-desktop {
    display: none;
    margin-left: auto;
  }

  .nav-desktop ul {
    display: flex;
    gap: 2px;
    margin: 0;
  }

  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .nav-desktop a:hover {
    background: var(--snow);
  }

  .nav-desktop a[aria-current='page'] {
    background: var(--ink);
    color: #fff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .header-cta {
    display: none;
  }

  .menu-button {
    display: inline-grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    transition: transform 0.3s var(--ease-spring);
  }

  .menu-button:active {
    transform: scale(0.92);
  }

  @media (min-width: 880px) {
    .nav-desktop {
      display: block;
    }

    .header-actions {
      margin-left: 8px;
    }

    .header-cta {
      display: inline-flex;
    }

    .menu-button:not(.menu-close) {
      display: none;
    }
  }

  /* ---- Mobile menu (popover): a full-screen blue panel ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    max-inline-size: 100%;
    block-size: 100dvh;
    max-block-size: 100dvh;
    margin: 0;
    padding: var(--edge);
    border: 0;
    background: var(--snow);
    color: #fff;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transition:
      opacity 0.25s var(--ease-out),
      overlay 0.3s allow-discrete,
      display 0.3s allow-discrete;
  }

  .mobile-menu:popover-open {
    opacity: 1;
  }

  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
    }
  }

  .mobile-menu::backdrop {
    background: transparent;
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    min-block-size: 100%;
    padding: 8px 20px 28px;
    border-radius: var(--r-panel);
    background: var(--blue);
  }

  .mobile-menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }

  .menu-close {
    background: #fff;
    color: var(--ink);
  }

  .mobile-links {
    margin: 20px 0 0;
  }

  .mobile-links li {
    animation: menu-in 0.5s var(--ease-out) both;
    animation-delay: calc(60ms + var(--i) * 40ms);
  }

  .mobile-menu:not(:popover-open) .mobile-links li {
    animation: none;
  }

  .mobile-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    border-bottom: 1.5px solid rgb(255 255 255 / 0.18);
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    text-decoration: none;
  }

  .mobile-links a :global(svg) {
    opacity: 0.6;
    transition: transform 0.3s var(--ease-spring), opacity 0.2s ease;
  }

  .mobile-links a:hover :global(svg),
  .mobile-links a[aria-current='page'] :global(svg) {
    opacity: 1;
    transform: translateX(4px);
  }

  .mobile-links a[aria-current='page'] {
    color: var(--tangerine);
  }

  .mobile-cta {
    margin-top: 32px;
    inline-size: 100%;
    min-height: 58px;
    font-size: 1.0625rem;
  }

  .mobile-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: auto;
    padding-top: 32px;
  }

  .mobile-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--blue-soft);
    font-size: 0.9375rem;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 880px) {
    .mobile-menu {
      display: none;
    }
  }

  :global(body:has(.mobile-menu:popover-open)) {
    overflow: hidden;
  }

  /* Browsers without the popover API: no menu button, show the links inline. */
  @supports not selector(:popover-open) {
    .mobile-menu,
    .menu-button {
      display: none !important;
    }

    .nav-desktop {
      display: block;
      margin-left: auto;
    }

    .nav-desktop a {
      padding: 0 10px;
    }
  }
</style>
