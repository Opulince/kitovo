---
/** One feature: icon, title, one or two sentences. */
import type { Feature } from '@/data/apps/types';
import Icon from './Icon.astro';

interface Props {
  feature: Feature;
}

const { feature } = Astro.props;
---

<li class="feature">
  <span class="feature-icon" aria-hidden="true">
    <Icon name={feature.icon} size={22} strokeWidth={2} />
  </span>
  <h3 class="feature-title">{feature.title}</h3>
  <p class="feature-body">{feature.body}</p>
</li>

<style>
  .feature {
    padding: 26px;
    border-radius: var(--r-lg);
    background: var(--snow);
    transition:
      transform 0.4s var(--ease-spring),
      background-color 0.25s ease;
  }

  .feature:hover {
    transform: translateY(-4px);
    background: var(--lilac);
  }

  .feature-icon {
    display: grid;
    place-items: center;
    inline-size: 48px;
    block-size: 48px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
  }

  .feature-title {
    margin-top: 22px;
    font-size: 1.375rem;
  }

  .feature-body {
    margin-top: 8px;
    color: var(--muted);
  }
</style>
