---
/**
 * Breadcrumb trail for nested pages (the matching BreadcrumbList JSON-LD is
 * produced by `breadcrumbJsonLd` in the page).
 */
import { toHref } from '@/config/site';
import type { Crumb } from '@/lib/seo';

interface Props {
  items: Crumb[];
  tone?: 'light' | 'dark';
}

const { items, tone = 'light' } = Astro.props;
---

<nav class:list={['crumbs', `crumbs-${tone}`]} aria-label="Breadcrumb">
  <ol role="list">
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? (
            <>
              <a href={toHref(item.href)}>{item.label}</a>
              <span class="crumb-sep" aria-hidden="true">/</span>
            </>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    text-decoration: none;
    opacity: 0.7;
  }

  .crumbs a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .crumb-sep {
    opacity: 0.4;
    margin-right: 4px;
  }

  .crumbs [aria-current='page'] {
    font-weight: 500;
  }

  .crumbs-dark {
    color: #fff;
  }

  .crumbs-dark a {
    opacity: 0.85;
  }
</style>
