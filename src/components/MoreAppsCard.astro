---
/**
 * The honest placeholder for future apps: no fake products, just an empty
 * slot and a note that more are coming.
 */
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={['more-apps', { 'more-apps-compact': compact }]} aria-label="More apps">
  <span class="more-slot" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
  </span>
  <div>
    <h3 class="more-title">More apps coming soon</h3>
    <p class="more-body">
      New Kitovo apps land here when they are ready for everyday use, not before.
    </p>
  </div>
</aside>

<style>
  .more-apps {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 24px clamp(22px, 4vw, 36px);
    border-radius: var(--r-lg);
    border: 2px dashed var(--line-strong);
  }

  .more-apps-compact {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    height: 100%;
    min-height: 260px;
    padding: 28px;
  }

  .more-slot {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 64px;
    block-size: 64px;
    border-radius: var(--r-icon);
    border: 2px dashed var(--line-strong);
    color: var(--muted);
  }

  .more-title {
    font-size: var(--step-1);
  }

  .more-body {
    margin-top: 4px;
    color: var(--muted);
    max-width: 52ch;
  }
</style>
