---
/**
 * A closing call to action. Content goes in the default slot (heading and
 * copy) and the `actions` slot (buttons).
 */
interface Props {
  tone?: 'mint' | 'pine';
  id?: string;
  labelledby?: string;
}

const { tone = 'mint', id, labelledby } = Astro.props;
---

<section class="section-tight" id={id} aria-labelledby={labelledby}>
  <div class="container">
    <div class:list={['cta-band', `cta-${tone}`, { 'on-dark': tone === 'pine' }]}>
      <div class="cta-copy">
        <slot />
      </div>
      <div class="cta-actions btn-row btn-row-stack">
        <slot name="actions" />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    display: grid;
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 5vw, 56px);
    border-radius: var(--r-xl);
    overflow: hidden;
    isolation: isolate;
  }

  .cta-mint {
    background: var(--mint);
  }

  .cta-pine {
    background: var(--pine);
    color: var(--pine-ink);
  }

  .cta-copy :global(h2) {
    font-size: var(--step-3);
    max-width: 22ch;
  }

  .cta-copy :global(p) {
    margin-top: 12px;
    color: var(--muted);
    font-size: var(--step-1);
    max-width: 50ch;
  }

  .cta-pine .cta-copy :global(h2) {
    color: #fff;
  }

  .cta-pine .cta-copy :global(p) {
    color: var(--pine-muted);
  }

  .cta-pine :global(.btn-ghost) {
    --btn-fg: #fff;
  }

  .cta-pine :global(.btn-ghost:hover) {
    --btn-bg: rgb(255 255 255 / 0.1);
  }

  @media (min-width: 900px) {
    .cta-band {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }
  }
</style>
