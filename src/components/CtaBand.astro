---
/**
 * A closing call-to-action panel. Heading and copy go in the default slot,
 * buttons in the `actions` slot.
 */
interface Props {
  tone?: 'tangerine' | 'blue' | 'ink' | 'lilac';
  id?: string;
  labelledby?: string;
}

const { tone = 'tangerine', id, labelledby } = Astro.props;
const dark = tone === 'blue' || tone === 'ink';
---

<section
  class:list={['cta panel', `panel-${tone}`, { 'on-dark': dark, 'cta-dark': dark }]}
  id={id}
  aria-labelledby={labelledby}
>
  <div class="container cta-inner">
    <div class="cta-copy">
      <slot />
    </div>
    <div class="cta-actions btn-row btn-row-stack">
      <slot name="actions" />
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(48px, 7vw, 96px);
    overflow: hidden;
  }

  .cta-inner {
    display: grid;
    gap: 32px;
    align-items: end;
  }

  .cta-copy :global(h2) {
    font-size: var(--step-4);
    letter-spacing: -0.05em;
    line-height: 0.95;
    max-width: 14ch;
  }

  .cta-copy :global(p) {
    margin-top: 18px;
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 46ch;
  }

  .cta-dark .cta-copy :global(p) {
    color: var(--blue-soft);
  }

  .panel-ink .cta-copy :global(p) {
    color: #c4c7d0;
  }

  @media (min-width: 900px) {
    .cta-inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }
  }
</style>
