---
/**
 * Questions and answers as native <details> disclosures: keyboard and
 * screen-reader friendly, and no JavaScript.
 */
import type { FaqItem } from '@/data/apps/types';
import Icon from './Icon.astro';

interface Props {
  items: FaqItem[];
  questionLevel?: 'h3' | 'h4';
}

const { items, questionLevel = 'h3' } = Astro.props;
const Q = questionLevel;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>
          <Q class="faq-q">{item.question}</Q>
          <span class="faq-toggle" aria-hidden="true">
            <Icon name="plus" size={18} strokeWidth={2.2} />
          </span>
        </summary>
        <div class="faq-a">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 8px;
  }

  .faq-item {
    border-radius: var(--r-md);
    background: var(--snow);
    transition: background-color 0.2s ease;
  }

  .faq-item[open] {
    background: var(--lilac);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 68px;
    padding: 14px 14px 14px 22px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--r-md);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .faq-toggle {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    background: var(--white);
    transition:
      transform 0.4s var(--ease-spring),
      background-color 0.2s ease,
      color 0.2s ease;
  }

  summary:hover .faq-toggle {
    background: var(--ink);
    color: #fff;
  }

  details[open] .faq-toggle {
    transform: rotate(45deg);
    background: var(--ink);
    color: #fff;
  }

  .faq-a {
    padding: 0 64px 22px 22px;
    max-width: 72ch;
  }

  details[open] .faq-a {
    animation: faq-open 0.35s var(--ease-out);
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 559px) {
    .faq-a {
      padding-right: 22px;
    }
  }
</style>
