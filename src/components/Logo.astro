---
/**
 * The Kitovo lockup: mark + wordmark. The wordmark is real text, so it stays
 * crisp and readable by screen readers.
 */
import LogoMark from './LogoMark.astro';

interface Props {
  tone?: 'ink' | 'light';
  size?: 'md' | 'lg';
}

const { tone = 'ink', size = 'md' } = Astro.props;
---

<span class:list={['logo', `logo-${tone}`, `logo-${size}`]}>
  <LogoMark size={size === 'lg' ? 36 : 26} tone={tone} class="logo-mark" />
  <span class="logo-word">kitovo</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    line-height: 1;
  }

  .logo-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -0.05em;
    color: var(--text);
    transform: translateY(-0.04em);
  }

  .logo-lg .logo-word {
    font-size: 2rem;
  }

  .logo-light .logo-word {
    color: #fff;
  }

  .logo-mark {
    flex: none;
  }
</style>
