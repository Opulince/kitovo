---
/**
 * The homepage hero, drawn as an Android home screen in Kitovo blue:
 * a status bar, an "at a glance" widget announcing the newest app, the
 * headline as the wallpaper, and a dock holding Kitovo's real apps.
 *
 * The dock fills itself from the app registry. Empty slots stay empty and
 * labelled as such: room for future apps, never invented ones.
 */
import { apps, appPath, primaryPlatform, statusLabel } from '@/data/apps';
import { toHref } from '@/config/site';
import AppIcon from './AppIcon.astro';
import Icon from './Icon.astro';

const DOCK_SLOTS = 4;
const emptySlots = Math.max(DOCK_SLOTS - apps.length, 0);
const featured = apps[0]!;
const featuredPlatform = primaryPlatform(featured);
---

<section class="home panel panel-blue on-blue" aria-labelledby="home-title">
  <!-- wallpaper -->
  <div class="wallpaper" aria-hidden="true">
    <span class="wp wp-1"></span>
    <span class="wp wp-2"></span>
    <span class="wp wp-3"></span>
  </div>

  <div class="status-bar container" aria-hidden="true">
    <span class="status-left">kitovo</span>
    <span class="status-icons">
      <svg viewBox="0 0 24 24" width="16" height="16"><path d="M2 20h3v-4H2zm5 0h3v-8H7zm5 0h3V8h-3zm5 0h3V4h-3z" fill="currentColor"></path></svg>
      <svg viewBox="0 0 24 24" width="16" height="16"><path d="M12 20 1.5 8.5a15 15 0 0 1 21 0Z" fill="currentColor"></path></svg>
      <svg viewBox="0 0 24 24" width="18" height="18"><rect x="2" y="7" width="17" height="10" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6"></rect><rect x="4" y="9" width="12" height="6" rx="1.2" fill="currentColor"></rect><rect x="20" y="10" width="2" height="4" rx="1" fill="currentColor"></rect></svg>
    </span>
  </div>

  <div class="container home-body">
    <a class="glance rise" href={toHref(appPath(featured))} style="--delay: 80ms">
      <AppIcon app={featured} size={44} />
      <span class="glance-text">
        <span class="glance-label">{statusLabel[featuredPlatform.status]} · {featuredPlatform.name}</span>
        <span class="glance-title">{featured.name}: {featured.tagline}</span>
      </span>
      <Icon name="arrow-right" size={20} strokeWidth={2} class="glance-arrow" />
    </a>

    <h1 id="home-title" class="home-title">
      <span class="line"><span style="--d: 0">Useful apps</span></span>
      <span class="line"><span style="--d: 1">for everyday</span></span>
      <span class="line"><span style="--d: 2">problems<span class="dot" aria-hidden="true"></span><span class="visually-hidden">.</span></span></span>
    </h1>

    <div class="home-foot">
      <p class="home-lead rise" style="--delay: 520ms">
        Kitovo is an independent Android studio. Each app does one job, and does it properly.
      </p>
      <div class="btn-row btn-row-stack rise" style="--delay: 600ms">
        <a href="#apps" class="btn btn-light">
          Explore apps
          <Icon name="arrow-right" />
        </a>
        <a href={toHref('/about')} class="btn btn-outline-light">About Kitovo</a>
      </div>
    </div>

    <nav class="dock" aria-label="Kitovo apps">
      <ul role="list">
        {
          apps.map((app, i) => (
            <li style={`--i:${i}`}>
              <a href={toHref(appPath(app))} class="dock-app">
                <AppIcon app={app} size={64} animated loading="eager" class="dock-icon" />
                <span class="dock-badge" aria-hidden="true" />
                <span class="dock-tip">{app.name}</span>
              </a>
            </li>
          ))
        }
        {
          Array.from({ length: emptySlots }, (_, i) => (
            <li style={`--i:${i + apps.length}`} aria-hidden="true">
              <span class="dock-slot" />
            </li>
          ))
        }
      </ul>
      <p class="dock-caption">
        {apps.length === 1 ? 'One app so far.' : `${apps.length} apps so far.`} More on the way.
      </p>
    </nav>
  </div>
</section>

<style>
  .home {
    padding-block: 18px clamp(28px, 4vw, 44px);
    min-height: min(calc(100svh - var(--header-h) - 3 * var(--edge)), 920px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ---- wallpaper: flat Material-style shapes ---- */
  .wallpaper {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .wp {
    position: absolute;
    border-radius: 50%;
  }

  .wp-1 {
    width: min(70vw, 760px);
    aspect-ratio: 1;
    right: -14%;
    top: -22%;
    background: #3a57ff;
  }

  .wp-2 {
    width: min(46vw, 480px);
    aspect-ratio: 1;
    right: 12%;
    bottom: -30%;
    background: #2541f0;
  }

  .wp-3 {
    width: min(20vw, 200px);
    aspect-ratio: 1;
    right: 6%;
    top: 42%;
    border-radius: 34%;
    background: #4964ff;
    transform: rotate(12deg);
  }

  /* ---- status bar ---- */
  .status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 28px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--blue-soft);
  }

  .status-icons {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .home-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 4vw, 40px);
    padding-top: clamp(20px, 4vw, 40px);
  }

  /* ---- "at a glance" widget ---- */
  .glance {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    align-self: flex-start;
    max-width: 100%;
    padding: 10px 18px 10px 10px;
    border-radius: var(--r-pill);
    background: rgb(16 17 20 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.16);
    color: #fff;
    text-decoration: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, transform 0.35s var(--ease-spring);
  }

  .glance:hover {
    background: rgb(16 17 20 / 0.24);
    transform: translateY(-2px);
  }

  .glance-text {
    display: grid;
    min-width: 0;
  }

  .glance-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-soft);
  }

  .glance-title {
    font-weight: 600;
    font-size: 0.975rem;
    line-height: 1.3;
  }

  .glance :global(.glance-arrow) {
    flex: none;
    transition: transform 0.3s var(--ease-spring);
  }

  .glance:hover :global(.glance-arrow) {
    transform: translateX(3px);
  }

  /* ---- headline: the wallpaper text ---- */
  .home-title {
    font-size: var(--step-5);
    line-height: 0.9;
    letter-spacing: -0.055em;
    color: #fff;
    margin-top: auto;
  }

  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .line > span {
    display: inline-block;
    animation: line-up 0.9s var(--ease-out) both;
    animation-delay: calc(140ms + var(--d) * 90ms);
  }

  .dot {
    display: inline-block;
    inline-size: 0.19em;
    block-size: 0.19em;
    margin-left: 0.04em;
    border-radius: 50%;
    background: var(--tangerine);
    animation: dot-drop 0.7s var(--ease-spring) both;
    animation-delay: 760ms;
  }

  .home-foot {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .home-lead {
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--blue-soft);
    max-width: 40ch;
  }

  /* ---- dock ---- */
  .dock {
    display: grid;
    justify-items: center;
    gap: 10px;
    margin-top: clamp(8px, 2vw, 16px);
  }

  .dock ul {
    display: flex;
    align-items: center;
    gap: clamp(14px, 3vw, 22px);
    margin: 0;
    padding: 12px clamp(14px, 3vw, 20px);
    border-radius: 34px;
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.2);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .dock li {
    animation: dock-pop 0.7s var(--ease-spring) both;
    animation-delay: calc(700ms + var(--i) * 70ms);
  }

  .dock-app {
    position: relative;
    display: block;
    border-radius: var(--r-icon);
    transition: transform 0.4s var(--ease-spring);
  }

  .dock-app:hover,
  .dock-app:focus-visible {
    transform: translateY(-6px) scale(1.08);
  }

  .dock-app :global(.dock-icon),
  .dock-slot {
    inline-size: clamp(52px, 13vw, 64px);
    block-size: clamp(52px, 13vw, 64px);
  }

  .dock-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    inline-size: 18px;
    block-size: 18px;
    border-radius: 50%;
    background: var(--tangerine);
    border: 3px solid var(--blue);
    animation: badge-in 0.5s var(--ease-spring) both;
    animation-delay: 1150ms;
  }

  .dock-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: #fff;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 650;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 6px);
    transition: opacity 0.2s ease, transform 0.3s var(--ease-spring);
    pointer-events: none;
  }

  .dock-app:hover .dock-tip,
  .dock-app:focus-visible .dock-tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .dock-slot {
    display: block;
    border-radius: var(--r-icon);
    border: 2px dashed rgb(255 255 255 / 0.35);
  }

  .dock-caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--blue-soft);
  }


  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  @keyframes dot-drop {
    0% {
      transform: translateY(-1.4em) scale(0.6);
      opacity: 0;
    }
    60% {
      opacity: 1;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes dock-pop {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.7);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes badge-in {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }
</style>
