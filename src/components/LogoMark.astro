---
/**
 * The Kitovo mark: three app tiles and a signal dot, arranged like a corner of
 * a phone's home screen. The dot sits where a notification badge would, which
 * is the whole idea: a small app that tells you something useful.
 */
interface Props {
  size?: number;
  class?: string;
  /** Tile colour. The dot is always marigold. */
  tone?: 'pine' | 'light';
}

const { size = 28, class: className, tone = 'pine' } = Astro.props;
const tile = tone === 'light' ? '#e6eee9' : '#123a2c';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="0" y="0" width="10.5" height="10.5" rx="3" fill={tile}></rect>
  <rect x="0" y="13.5" width="10.5" height="10.5" rx="3" fill={tile}></rect>
  <rect x="13.5" y="13.5" width="10.5" height="10.5" rx="3" fill={tile}></rect>
  <circle cx="18.75" cy="5.25" r="5.25" fill="#f2b33d"></circle>
</svg>
