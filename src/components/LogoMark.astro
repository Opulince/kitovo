---
/**
 * The Kitovo mark: three app tiles and a signal dot, like the corner of a
 * phone's home screen. The dot sits where a notification badge would: a small
 * app telling you something useful at the right moment.
 */
interface Props {
  size?: number;
  class?: string;
  /** Tile colour. The dot is always tangerine. */
  tone?: 'ink' | 'light';
}

const { size = 28, class: className, tone = 'ink' } = Astro.props;
const tile = tone === 'light' ? '#ffffff' : '#101114';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect x="0" y="0" width="10.5" height="10.5" rx="3.2" fill={tile}></rect>
  <rect x="0" y="13.5" width="10.5" height="10.5" rx="3.2" fill={tile}></rect>
  <rect x="13.5" y="13.5" width="10.5" height="10.5" rx="3.2" fill={tile}></rect>
  <circle cx="18.75" cy="5.25" r="5.25" fill="#ff6a3d"></circle>
</svg>
