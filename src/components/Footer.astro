---
/**
 * The publisher footer: who Kitovo is, every app, help, and the legal pages.
 * App links come from the registry, so new apps appear here automatically.
 * It ends with the wordmark set huge, like a signature.
 */
import { site, toHref } from '@/config/site';
import { apps, appPath } from '@/data/apps';
import LogoMark from './LogoMark.astro';

const columns = [
  {
    title: 'Apps',
    links: [
      ...apps.map((app) => ({ href: appPath(app), label: app.name })),
      { href: '/apps', label: 'All apps' },
    ],
  },
  {
    title: 'Kitovo',
    links: [
      { href: '/about', label: 'About' },
      { href: '/support', label: 'Support' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/terms', label: 'Terms' },
      { href: '/disclaimer', label: 'Disclaimer' },
    ],
  },
];
---

<footer class="site-footer panel panel-ink on-dark">
  <div class="container footer-top">
    <div class="footer-brand">
      <p class="footer-tagline">{site.tagline}</p>
      <p class="footer-note">An independent studio making simple, focused Android apps.</p>
      <a class="footer-mail" href={`mailto:${site.contact.generalEmail}`}>{site.contact.generalEmail}</a>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="footer-col">
            <h2 class="footer-heading">{col.title}</h2>
            <ul role="list">
              {col.links.map((link) => (
                <li>
                  <a href={toHref(link.href)}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="container footer-sign" aria-hidden="true">
    <span class="footer-word">kitovo</span>
    <LogoMark size={120} tone="light" class="footer-mark" />
  </div>

  <div class="container footer-bottom">
    <p>Copyright © {site.copyrightYear} Kitovo. All rights reserved.</p>
    <p class="footer-small">
      Android and Google Play are trademarks of Google LLC.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(48px, 7vw, 88px) 28px;
    overflow: hidden;
  }

  .footer-top {
    display: grid;
    gap: 48px;
  }

  .footer-tagline {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 12ch;
  }

  .footer-note {
    margin-top: 16px;
    color: #b9bcc6;
    max-width: 36ch;
  }

  .footer-mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 8px;
    font-weight: 600;
    color: var(--tangerine);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9da1ad;
    margin-bottom: 10px;
  }

  .footer-col ul {
    margin: 0;
    display: grid;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: #fff;
    font-weight: 500;
    font-size: 1.0625rem;
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--tangerine);
  }

  .footer-sign {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(40px, 7vw, 88px);
    user-select: none;
  }

  .footer-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4.5rem, 21vw, 18rem);
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: #fff;
    margin-left: -0.04em;
  }

  .footer-sign :global(.footer-mark) {
    inline-size: clamp(56px, 11vw, 150px);
    block-size: auto;
    flex: none;
    margin-bottom: 0.4%;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 32px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.9rem;
    color: #d6d8de;
  }

  .footer-small {
    color: #9da1ad;
    font-size: 0.8125rem;
  }

  @media (min-width: 560px) {
    .footer-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .footer-top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr);
      gap: 64px;
    }
  }
</style>
