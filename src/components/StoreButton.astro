---
/**
 * The Google Play call to action for an app.
 *
 * With a store URL it is a real button. Without one it is a plain status line
 * ("Coming soon to Google Play"), not a button: a button that goes nowhere
 * would be a lie. Google's Play badge artwork isn't used; a text button keeps
 * within Google's brand rules.
 */
import type { AppDefinition } from '@/data/apps';
import { androidPlatform } from '@/data/apps';
import Icon from './Icon.astro';

interface Props {
  app: AppDefinition;
  tone?: 'light' | 'dark';
}

const { app, tone = 'light' } = Astro.props;
const android = androidPlatform(app);
const url = android?.status === 'available' ? android.storeUrl : null;
---

{
  url ? (
    <a
      class:list={['btn', tone === 'dark' ? 'btn-light' : 'btn-primary']}
      href={url}
      rel="noopener"
      target="_blank"
    >
      <Icon name="phone" />
      Get it on Google Play
      <span class="visually-hidden">(opens Google Play in a new tab)</span>
    </a>
  ) : android ? (
    <p class:list={['store-pending', `store-pending-${tone}`]}>
      <span class="store-pending-dot" aria-hidden="true" />
      {android.status === 'in-development' ? 'In development for Android' : 'Coming soon to Google Play'}
    </p>
  ) : null
}

<style>
  .store-pending {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65em;
    min-height: 52px;
    padding: 0 1.4rem;
    border-radius: var(--r-pill);
    border: 2px dashed var(--line-strong);
    color: var(--text);
    font-weight: 650;
    font-size: 1rem;
  }

  .store-pending-dark {
    color: #fff;
    border-color: rgb(255 255 255 / 0.4);
  }

  .store-pending-dot {
    inline-size: 0.6em;
    block-size: 0.6em;
    border-radius: 50%;
    background: var(--tangerine);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(255 106 61 / 0.55);
    }
    50% {
      box-shadow: 0 0 0 7px rgb(255 106 61 / 0);
    }
  }
</style>
