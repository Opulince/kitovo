---
/**
 * A release status chip: "Android · Coming soon".
 */
import { statusLabel } from '@/data/apps';
import type { ReleaseStatus } from '@/data/apps/types';

interface Props {
  status: ReleaseStatus;
  platform?: string;
  size?: 'sm' | 'md';
  tone?: 'light' | 'dark';
}

const { status, platform, size = 'md', tone = 'light' } = Astro.props;
---

<span class:list={['status', `status-${status}`, `status-${size}`, `status-on-${tone}`]}>
  <span class="status-dot" aria-hidden="true"></span>
  {platform && <span class="status-platform">{platform}</span>}
  {platform && <span class="status-sep" aria-hidden="true">·</span>}
  <span>{statusLabel[status]}</span>
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 30px;
    padding: 0 0.85em 0 0.75em;
    border-radius: var(--r-pill);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .status-md {
    min-height: 34px;
    font-size: 0.75rem;
  }

  .status-dot {
    inline-size: 0.7em;
    block-size: 0.7em;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  .status-sep {
    opacity: 0.5;
  }

  .status-available {
    background: var(--mint);
    color: var(--mint-ink);
  }

  .status-coming-soon {
    background: var(--tangerine-soft);
    color: #7a2a0d;
  }

  .status-coming-soon .status-dot {
    background: var(--tangerine);
  }

  .status-in-development {
    background: var(--snow);
    color: #3d414b;
  }

  .status-on-dark.status-coming-soon {
    background: var(--tangerine);
    color: var(--ink);
  }

  .status-on-dark.status-coming-soon .status-dot {
    background: var(--ink);
  }

  .status-on-dark.status-in-development {
    background: rgb(255 255 255 / 0.14);
    color: #fff;
  }

  .status-on-dark.status-available {
    background: var(--mint);
    color: var(--mint-ink);
  }
</style>
