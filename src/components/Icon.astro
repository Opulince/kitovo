---
/**
 * Inline SVG icon from the set in ./icons.ts. Decorative by default
 * (aria-hidden); pass `label` when the icon is the only content of a control.
 */
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, label, class: className, strokeWidth = 1.75 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  data-icon={name}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
/>
